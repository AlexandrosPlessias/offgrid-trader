# Never bake secrets or local env overrides into images.
# Secrets are injected at runtime via docker-compose env_file.
.env
**/.env

# Local Python / virtualenv artifacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local database + generated data
*.db
data/

# Git / editor / CI metadata
.git/
.github/
.vscode/
.idea/

# Docs & tests are not needed inside the runtime image
docs/
smoke_test.py
