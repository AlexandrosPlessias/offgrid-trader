# ---------------------------------------------------------------------------
# offgrid-trader configuration example.
# Copy to `.env` and edit. NEVER commit your real .env (it is gitignored).
# All secrets are read from the environment; nothing is hardcoded.
# ---------------------------------------------------------------------------

# --- Watchlist & scanning -------------------------------------------------
# Comma-separated tickers to monitor.
WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMD,SPY
# How often to scan (minutes) while the market is open.
SCAN_INTERVAL_MINUTES=15
# SQLite database file path.
DATABASE_PATH=offgrid_trader.db
# Comma-separated CORS origins (frontend dev servers).
# In Docker, frontend is on :5174 to avoid clashing with insurance-agent-rag-poc (:5173).
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# --- Ollama (local LLM) ---------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=120

# --- Market hours (America/New_York) --------------------------------------
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0

# --- Signal thresholds ----------------------------------------------------
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
VOLUME_SPIKE_MULTIPLIER=2.0
SIGNIFICANT_MOVE_PCT=2.0
# Minimum confidence (0-100) required to store/alert on a signal.
CONFIDENCE_FLOOR=65

# --- Email alerts (Gmail SMTP + App Password) -----------------------------
# Create an App Password at https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=recipient@example.com

# --- Slack alerts (Incoming Webhook) --------------------------------------
# Create one at https://api.slack.com/messaging/webhooks
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Telegram alerts (Bot API) --------------------------------------------
# 1. Create a bot via @BotFather → copy the token below.
# 2. Start a chat with your bot, then get the chat_id:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Finnhub (optional news headlines) ------------------------------------
# Get a free API key at https://finnhub.io/  (60 req/min on the free tier).
# When set, up to 5 recent headlines are injected into each AI prompt.
# FINNHUB_API_KEY=

# --- Global alert send switch ---------------------------------------------
# Set false to suppress email + Slack during local testing.
# Telegram is unaffected — it uses its own TELEGRAM_ENABLED flag.
# Can also be toggled at runtime from the UI without restarting.
ALERTS_SEND_ENABLED=true

# --- OpenTelemetry / Aspire telemetry ------------------------------------
# OTLP gRPC endpoint for traces, metrics, and structured logs.
# In Docker this is set automatically by docker-compose.yml (http://aspire:18889).
# For local dev outside Docker: point to the Aspire container on the host,
#   e.g. OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
# Leave empty to disable telemetry entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
