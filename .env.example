# ---------------------------------------------------------------------------
# offgrid-trader configuration example.
# Copy to `.env` and edit. NEVER commit your real .env (it is gitignored).
# All secrets are read from the environment; nothing is hardcoded.
# ---------------------------------------------------------------------------

# ── Security ──────────────────────────────────────────────────────────────────
# Admin token — required for ALL public / internet-facing deployments.
# Gates the entire API via AdminTokenMiddleware; also used as the login password
# on the web UI login screen.
# When blank: all routes are open (safe for local / Docker-only use).
# For Fly.io: set via `fly secrets set ADMIN_TOKEN=<your-strong-secret>`
# ADMIN_TOKEN=your-secret-token-here

# For Vercel deployment: set VITE_API_URL=https://your-fly-app.fly.dev in Vercel
# project env vars.  For Fly.io: set CORS_ORIGINS=https://your-app.vercel.app
# via `fly secrets set` after first Vercel deploy.

# --- Watchlist & scanning -------------------------------------------------
# Comma-separated tickers to monitor.
WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMD,SPY
# How often to scan (minutes) while the market is open.
SCAN_INTERVAL_MINUTES=15
# Start auto-scan automatically on every container boot.
# false = manual mode — enable from the Settings page when you are ready.
# Once you toggle auto-scan via the UI, the DB state overrides this value on
# future restarts (you don't need to change this file).
SCHEDULER_AUTO_START=false
# SQLite database file path.
DATABASE_PATH=offgrid_trader.db
# Comma-separated CORS origins (frontend dev servers).
# In Docker, frontend is on :5174 to avoid clashing with insurance-agent-rag-poc (:5173).
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# ── AI Provider ───────────────────────────────────────────────────────────────
# Values: ollama (default, local) | groq | gemini | mistral | custom
# Can also be changed live from the Settings page → AI Provider without restarting.
LLM_PROVIDER=ollama

# Local Ollama (used when LLM_PROVIDER=ollama) ────────────────────────────────
# GPU VRAM guide: qwen2.5:3b ≈ 3 GB · :7b ≈ 5 GB · :14b ≈ 10 GB
OLLAMA_HOST=http://localhost:11434
# Model options: qwen2.5:3b (2 GB VRAM) · qwen2.5:7b (5 GB) · qwen2.5:14b (10 GB) · qwen2.5:32b (20 GB)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Groq Cloud — free, no credit card — https://console.groq.com ────────────────
# Free tier: ~30 req/min, 6 000 req/day — enough for a 6-ticker watchlist at
# 15-min intervals (~0.4 req/min).  Set LLM_PROVIDER=groq to activate.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=qwen/qwen3.6-27b    # optional — default shown

# Google Gemini — free, no credit card — https://aistudio.google.com ──────────
# Get a free API key at aistudio.google.com (Google account only, no billing).
# Free tier: Flash-Lite 1 000 req/day · Flash 250 req/day.  Set LLM_PROVIDER=gemini.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash-lite    # optional — default shown
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Mistral AI — free, no credit card — https://console.mistral.ai ──────────────
# Email signup only; ~1 B tokens/month free, training opt-out available.
# Set LLM_PROVIDER=mistral to activate.
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-small-latest    # optional — default shown
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Custom OpenAI-compatible endpoint ───────────────────────────────────────────
# Point at any vLLM, LM Studio, or self-hosted inference server.
# Set LLM_PROVIDER=custom to activate.
# LLM_BASE_URL=https://your-host/v1
# LLM_API_KEY=...
# LLM_MODEL=your-model-name

# Cloud inference timeout (seconds) — increase if provider is slow
# CLOUD_LLM_TIMEOUT=60

# Fallback provider — automatically used when the primary returns HTTP 429 ────
# Requires the fallback provider's API key to also be set above.
# Both can also be changed live from Settings → AI Provider → Fallback.
# LLM_FALLBACK_PROVIDER=gemini
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite    # optional — provider default used when blank

# --- Market hours (America/New_York) --------------------------------------
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0

# --- Signal thresholds ----------------------------------------------------
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
VOLUME_SPIKE_MULTIPLIER=2.0
SIGNIFICANT_MOVE_PCT=2.0
# Minimum confidence (0-100) required to store/alert on a signal.
CONFIDENCE_FLOOR=75

# --- Email alerts (Gmail SMTP + App Password) -----------------------------
# Create an App Password at https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=recipient@example.com

# --- ntfy push notifications -----------------------------------------------
# Self-hosted ntfy server — runs automatically in Docker (local) and as a
# sidecar on Fly.io (cloud).  No external service required.
#
# 1. Pick a random topic name (acts as a shared secret):
#    openssl rand -hex 12   →  e.g. marketsage-a1b2c3d4e5f6
# 2. Set NTFY_ENABLED=true and paste the topic below.
# 3. Subscribe in the ntfy app: http://<host>:18880/<your-topic>  (local)
#    or  https://offgrid-trader.fly.dev:18880/<your-topic>  (Fly.io)
NTFY_ENABLED=false
NTFY_TOPIC=
# Server URL — override to point at the correct deployment:
#   Local Docker:    NTFY_SERVER=http://ntfy:80
#   Fly.io sidecar:  NTFY_SERVER=http://localhost:18880  (set automatically via fly.toml)
NTFY_SERVER=http://localhost:18880

# Public URL of this backend — embedded in ntfy action buttons for paper trades.
# Local:   BACKEND_PUBLIC_URL=http://localhost:8010
# Fly.io:  BACKEND_PUBLIC_URL=https://offgrid-trader.fly.dev
BACKEND_PUBLIC_URL=http://localhost:8010

# --- Telegram alerts (Bot API) --------------------------------------------
# 1. Create a bot via @BotFather → copy the token below.
# 2. Start a chat with your bot, then get the chat_id:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional secret token for verifying Telegram webhook callbacks (POST /notifications/telegram/callback).
# Set via `fly secrets set TELEGRAM_WEBHOOK_SECRET=<random>` for cloud deployments.
# TELEGRAM_WEBHOOK_SECRET=

# --- Finnhub (optional news headlines) ------------------------------------
# Get a free API key at https://finnhub.io/  (60 req/min on the free tier).
# When set, up to 5 recent headlines are injected into each AI prompt.
# FINNHUB_API_KEY=

# --- FRED (US macro data) -------------------------------------------------
# Optional but strongly recommended when running inside Docker on a corporate
# VPN. The key-free CSV endpoint (fred.stlouisfed.org) is often blocked at the
# IP level in such environments; the REST API (api.stlouisfed.org) is not.
# Get a free key (instant) at: https://fred.stlouisfed.org/docs/api/api_key.html
# Rate limit: 120 req/min — more than sufficient for a 6-hour cached fetch.
# FRED_API_KEY=

# --- Alpaca paper trading -------------------------------------------------
# Sign up at https://alpaca.markets — paper trading is free.
# Generate API keys at https://app.alpaca.markets/paper-trading/overview
# Can also be configured live from Settings → Paper Trading without restarting.
# IMPORTANT: URL must include /v2 — without it the account endpoint returns empty
# data and no orders are placed, even if the keys are correct.
ALPACA_PAPER_URL=https://paper-api.alpaca.markets/v2
# ALPACA_API_KEY_ID=PKxxxxxxxxxxxxxxxxxxxxxx
# ALPACA_API_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Label shown on the Trading page to identify the current paper-trading session.
# Loaded automatically when clicking "Load Environment Default Values" in Settings.
PAPER_PROFILE_NAME=offgrid-trader-paper

# --- Fractional trading (2nd Alpaca profile) ------------------------------
# A SEPARATE Alpaca account/profile with its OWN keys, used by the fractional
# engine (Trading → Fractional Trading). It places small notional fractional
# buys (long-only) and cashes out on the signal's stop/target via an app-side
# poller. Can also be configured live from Settings → Live / Fractional Trading.
#
# Monitor on PAPER first, then go live by pointing FRAC_ALPACA_URL at the live
# host (https://api.alpaca.markets/v2) and pasting LIVE keys — real money.
# NOTE: Alpaca paper and live are different accounts with different keys.
FRAC_PROFILE_NAME=offgrid-trader-frac
FRAC_ALPACA_URL=https://paper-api.alpaca.markets/v2
# FRAC_ALPACA_KEY_ID=PKxxxxxxxxxxxxxxxxxxxxxx
# FRAC_ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Notional (account currency) invested per fractional buy.
FRAC_POSITION_SIZE=15
# Cap on total deployed notional across all open fractional positions.
FRAC_BUDGET=100
# How often (seconds) the exit poller checks live prices to enforce stop/target.
FRAC_POLL_SECONDS=60

# --- Global alert send switch ---------------------------------------------
# Set false to suppress email during local testing.
# Telegram and ntfy are unaffected — they use their own enable flags.
# Can also be toggled at runtime from the UI without restarting.
ALERTS_SEND_ENABLED=true

# --- OpenTelemetry / Aspire telemetry ------------------------------------
# OTLP gRPC endpoint for traces, metrics, and structured logs.
# In Docker this is set automatically by docker-compose.yml (http://aspire:18889).
# For local dev outside Docker: point to the Aspire container on the host,
#   e.g. OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
# Leave empty to disable telemetry entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Include full prompt and response text in Aspire span events.
# Enabled by default so you can see the complete LLM call sequence in Aspire
# (system prompt → user prompt → assistant response).
# Set to false in shared/production environments where prompt text
# (ticker context, balance sheet data) should not be stored in the trace backend.
OTEL_INCLUDE_LLM_CONTENT=true
