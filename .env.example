# ═══════════════════════════════════════════════════════════════════════════
# offgrid-trader — configuration example
# Copy to `.env` and edit. NEVER commit your real .env (it is gitignored).
# All secrets are read from the environment; nothing is hardcoded.
# Most values can also be changed live from the Settings page (DB overrides env).
# ═══════════════════════════════════════════════════════════════════════════


# ═══ 1 · CORE ════════════════════════════════════════════════════════════════

# Admin token — gates the whole API (AdminTokenMiddleware) + web-UI login.
# Blank = all routes open (local/Docker only). REQUIRED for internet deploys.
# Fly.io: `fly secrets set ADMIN_TOKEN=<strong-secret>`
# ADMIN_TOKEN=your-secret-token-here

# Comma-separated tickers to monitor.
WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMD,SPY
# Scan cadence (minutes) while the market is open.
SCAN_INTERVAL_MINUTES=15
# Start auto-scan on boot. false = manual (enable from Settings). Once toggled
# in the UI, the DB value wins on future restarts.
SCHEDULER_AUTO_START=false
# SQLite database file path.
DATABASE_PATH=offgrid_trader.db
# Allowed CORS origins (frontend dev servers). :5174 avoids clashing with :5173.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
# Deploy note — Vercel: set VITE_API_URL=https://<fly-app>.fly.dev in Vercel env;
# Fly.io: set CORS_ORIGINS=https://<app>.vercel.app after the first Vercel deploy.


# ═══ 2 · AI PROVIDER ═════════════════════════════════════════════════════════
# ollama (default, local) | groq | gemini | mistral | custom
# Switchable live from Settings → AI Provider.
LLM_PROVIDER=ollama

# ── Ollama (local) ── VRAM: qwen2.5:3b ≈ 3 GB · :7b ≈ 5 GB · :14b ≈ 10 GB ──────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# ── Groq Cloud (free) — https://console.groq.com ──────────────────────────────
# ~30 req/min, 6 000 req/day. Set LLM_PROVIDER=groq to activate.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=qwen/qwen3.6-27b

# ── Google Gemini (free) — https://aistudio.google.com ────────────────────────
# Flash-Lite 1 000 req/day · Flash 250 req/day. Set LLM_PROVIDER=gemini.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Mistral AI (free) — https://console.mistral.ai ────────────────────────────
# ~1 B tokens/month free. Set LLM_PROVIDER=mistral.
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── Custom OpenAI-compatible endpoint (vLLM, LM Studio, …) ────────────────────
# Set LLM_PROVIDER=custom.
# LLM_BASE_URL=https://your-host/v1
# LLM_API_KEY=...
# LLM_MODEL=your-model-name

# ── Cloud tuning ──────────────────────────────────────────────────────────────
# CLOUD_LLM_TIMEOUT=60
# Fallback used automatically on HTTP 429 (needs that provider's key set above).
# LLM_FALLBACK_PROVIDER=gemini
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite


# ═══ 3 · MARKET & SIGNALS ════════════════════════════════════════════════════
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0

RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
VOLUME_SPIKE_MULTIPLIER=2.0
SIGNIFICANT_MOVE_PCT=2.0
# Minimum confidence (0-100) to store/alert on a signal.
CONFIDENCE_FLOOR=75


# ═══ 4 · NOTIFICATIONS ═══════════════════════════════════════════════════════
# Global send switch — false suppresses email only (Telegram/ntfy use own flags).
ALERTS_SEND_ENABLED=true


# ── ntfy push (self-hosted; runs in Docker locally / Fly sidecar in cloud) ────
# Topic acts as a shared secret — generate one: openssl rand -hex 12
# Subscribe in the ntfy app at http://<host>:18880/<topic>.
NTFY_ENABLED=false
NTFY_TOPIC=
# Server URL — Local Docker: http://ntfy:80 · Fly sidecar: http://localhost:18880
NTFY_SERVER=http://localhost:18880
# Public backend URL — embedded in ntfy action buttons.
# Local: http://localhost:8010 · Fly.io: https://offgrid-trader.fly.dev
BACKEND_PUBLIC_URL=http://localhost:8010

# ── Telegram (Bot API) ── create via @BotFather; chat_id from getUpdates ──────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional webhook-callback secret (POST /notifications/telegram/callback).
# TELEGRAM_WEBHOOK_SECRET=


# ═══ 5 · DATA PROVIDERS (optional) ═══════════════════════════════════════════
# Finnhub — free news headlines (60 req/min): https://finnhub.io/
# When set, up to 5 recent headlines are injected into each AI prompt.
# FINNHUB_API_KEY=
# FRED — US macro data. Recommended on corporate VPNs where the key-free CSV
# endpoint is IP-blocked but the REST API is not: https://fred.stlouisfed.org
# FRED_API_KEY=


# ═══ 6 · TRADING ═════════════════════════════════════════════════════════════

# ── Alpaca paper (whole-share bracket orders) — https://alpaca.markets ────────
# Keys: app.alpaca.markets/paper-trading/overview. Configurable live in Settings.
# URL MUST include /v2, or the account endpoint returns empty and no orders fire.
ALPACA_PAPER_URL=https://paper-api.alpaca.markets/v2
# ALPACA_API_KEY_ID=PKxxxxxxxxxxxxxxxxxxxxxx
# ALPACA_API_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Label for the current paper-trading session (shown on the Trading page).
PAPER_PROFILE_NAME=offgrid-trader-paper

# ── Fractional (2nd Alpaca profile, own keys) — small notional long-only buys ──
# Exits via an app-side stop/target poller. Monitor on PAPER, then go live by
# pointing FRAC_ALPACA_URL at https://api.alpaca.markets/v2 with LIVE keys.
FRAC_PROFILE_NAME=offgrid-trader-frac
FRAC_ALPACA_URL=https://paper-api.alpaca.markets/v2
# FRAC_ALPACA_KEY_ID=PKxxxxxxxxxxxxxxxxxxxxxx
# FRAC_ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Notional per fractional buy / total open-notional cap / exit-poll cadence (s).
FRAC_POSITION_SIZE=15
FRAC_BUDGET=100
FRAC_POLL_SECONDS=60

# ── Autonomous loop ── signals auto-place orders; all editable in Settings ────
# Master switches (default: paper on, frac off).
PAPER_TRADING_ENABLED=true
FRAC_TRADING_ENABLED=false
# Fractional floor — stricter than CONFIDENCE_FLOOR (frac commits notional).
FRAC_MIN_CONFIDENCE=85
# Optional bracket-only floor (0 = fall back to CONFIDENCE_FLOOR).
PAPER_TRADE_MIN_CONFIDENCE=0
# Hold new bracket orders past this many open positions.
PAPER_MAX_POSITIONS=5
# Tradability gate: untradable (default) drops only permanently unactionable;
# strict also drops transiently blocked (no funds/cap); never keeps all signals.
SIGNAL_DROP_MODE=untradable
# Safety rail — autonomous frac buys stay paper-only unless true.
FRAC_AUTOTRADE_ALLOW_LIVE=false
# Discovery → watchlist auto-add, and its per-run cap (strongest N by score).
DISCOVERY_AUTOADD_ENABLED=false
DISCOVERY_AUTOADD_TOP_N=5


# ═══ 7 · OBSERVABILITY ═══════════════════════════════════════════════════════
# OTLP gRPC endpoint (Docker sets http://aspire:18889 automatically).
# Blank = telemetry disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Include full prompt/response text in Aspire spans. Set false in shared envs
# where prompt content (ticker/balance-sheet data) shouldn't be stored.
OTEL_INCLUDE_LLM_CONTENT=true


# ═══ 8 · INFRASTRUCTURE ══════════════════════════════════════════════════════
# Cloudflare Workers cron (infra/cron-worker/) — starts/stops the Fly app and
# sends EoD + weekly reports on schedule. Read by set-secrets.sh.
# See docs/wiki/cloudflare-cron.md. Fly deploy token: Fly dashboard → app →
# Settings → Tokens → Create deploy token (scoped to this app only).
CRON_WORKER_FLY_API_TOKEN=
# Fly app name (must match fly.toml).
CRON_WORKER_FLY_APP_NAME=offgrid-trader

# ═══ 9 · MISCELLANEOUS ══════════════════════════════════════════════════════
